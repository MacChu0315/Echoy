# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico echoy"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
# Main accepts the image after UI creation and before activating audio. The
# delayed default acceptance task would write flash during PCM streaming.
# CONFIG_ESP_MOSAICO_APP_AUTO_ACCEPT is not set
# The loading view submits 27 component changes plus initial image/callback
# commands. Keep that bounded startup burst above the SDK default of 24 slots.
CONFIG_ESP_GSP_QUEUE_DEPTH=64
